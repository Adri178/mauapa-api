# Copy to .env and adjust. Never commit .env.

# development | test | production
NODE_ENV=development
PORT=3000

# Matches docker-compose.yml credentials
DATABASE_URL="postgresql://mauapa:mauapa@localhost:5432/mauapa?schema=public"
REDIS_URL="redis://localhost:6379"

# Min 32 chars each, and they must differ. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string-32"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Global fallback rate limit, counted in Redis so it holds across instances.
# Tighter per-route limits (auth, registration, booking) live in
# src/throttling/throttling.constants.ts.
THROTTLE_ENABLED=true
THROTTLE_LIMIT=120
THROTTLE_TTL_SECONDS=60
