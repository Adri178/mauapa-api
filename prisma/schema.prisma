generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // btree_gist lets a GiST EXCLUDE constraint mix an equality column (staff_id)
  // with a range column (tstzrange) — the anti-double-booking guard in Phase 4.
  extensions = [btree_gist]
}

enum Role {
  OWNER
  STAFF
  CUSTOMER
}

enum BookingStatus {
  BOOKED
  WAITING
  IN_PROGRESS
  DONE
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  shops         Shop[]
  staffProfile  Staff?
  bookings      Booking[]

  @@map("users")
}

/// The tenant boundary. Every service, staff member, working-hours row, and
/// (from Phase 4) booking hangs off a shop, and every query is scoped by it.
model Shop {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  address   String
  /// IANA zone (e.g. Asia/Jakarta). Opening hours are wall-clock times; this is
  /// what turns them into real instants when slots are computed in Phase 3.
  timezone  String   @default("Asia/Jakarta")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  services     Service[]
  staff        Staff[]
  workingHours WorkingHours[]
  bookings     Booking[]

  @@index([ownerId])
  @@map("shops")
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  shopId          String   @map("shop_id") @db.Uuid
  name            String
  durationMinutes Int      @map("duration_minutes")
  /// Whole rupiah. Integer, never a float — money and binary fractions do not mix.
  price           Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("services")
}

model Staff {
  id     String  @id @default(uuid()) @db.Uuid
  shopId String  @map("shop_id") @db.Uuid
  name   String
  /// Optional link to a login. A staff member can exist as a schedulable
  /// resource before (or without) ever having an account.
  userId String? @unique @map("user_id") @db.Uuid
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([shopId])
  @@map("staff")
}

/// One row per open day. Minutes from midnight rather than a TIME column: slot
/// arithmetic in Phase 3 is then plain integer maths, with no timezone
/// ambiguity baked into the stored value. A day absent here is a closed day.
model WorkingHours {
  id          String @id @default(uuid()) @db.Uuid
  shopId      String @map("shop_id") @db.Uuid
  /// 0 = Sunday through 6 = Saturday, matching JavaScript's getDay().
  dayOfWeek   Int    @map("day_of_week")
  openMinute  Int    @map("open_minute")
  closeMinute Int    @map("close_minute")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, dayOfWeek])
  @@map("working_hours")
}

/// Times are stored as absolute instants (timestamptz). Wall-clock times belong
/// to a shop's timezone; storing instants keeps comparisons and overlap checks
/// unambiguous no matter where the caller is.
///
/// The concurrency guard that makes two overlapping bookings impossible is a
/// GiST EXCLUDE constraint over (staff_id, tstzrange(start_time, end_time)).
/// Prisma cannot express it, so Phase 4 adds it as raw SQL in a migration.
model Booking {
  id         String        @id @default(uuid()) @db.Uuid
  shopId     String        @map("shop_id") @db.Uuid
  serviceId  String        @map("service_id") @db.Uuid
  staffId    String        @map("staff_id") @db.Uuid
  customerId String        @map("customer_id") @db.Uuid
  startTime  DateTime      @map("start_time") @db.Timestamptz(3)
  endTime    DateTime      @map("end_time") @db.Timestamptz(3)
  status     BookingStatus @default(BOOKED)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  shop     Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  service  Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff    Staff   @relation(fields: [staffId], references: [id], onDelete: Restrict)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Drives the availability lookup: "which bookings does this staff member
  /// already have on this day?"
  @@index([staffId, startTime])
  @@index([shopId, startTime])
  @@index([customerId, startTime])
  @@map("bookings")
}

/// Refresh tokens are signed JWTs, but a hash of each one is persisted so it can
/// be revoked — a signature alone is valid until it expires and cannot be taken
/// back. Only the hash is stored: a leaked database row cannot be replayed.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
